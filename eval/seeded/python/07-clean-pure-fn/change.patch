diff --git a/mathutil/core.py b/mathutil/core.py
index 107e0d0..915f6ee 100644
--- a/mathutil/core.py
+++ b/mathutil/core.py
@@ -4,3 +4,13 @@
 def lerp(start: float, end: float, t: float) -> float:
     """Return the point `t` of the way from `start` to `end`."""
     return start + (end - start) * t
+
+
+def clamp(value: float, low: float, high: float) -> float:
+    """Return `value` limited to the closed range [`low`, `high`].
+
+    Raises ValueError when `low` is greater than `high`.
+    """
+    if low > high:
+        raise ValueError(f"low ({low}) must not exceed high ({high})")
+    return max(low, min(value, high))
