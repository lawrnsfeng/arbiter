--- /dev/null
+++ b/inventory/web.py
@@ -0,0 +1,42 @@
+"""Read-only HTTP API: GET /search?q=TEXT returns matching items as JSON."""
+
+import json
+import sqlite3
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from urllib.parse import parse_qs, urlsplit
+
+from inventory import db
+
+
+def make_handler(database: str) -> type[BaseHTTPRequestHandler]:
+    """Build a request handler class bound to the database at `database`."""
+
+    class Handler(BaseHTTPRequestHandler):
+        def do_GET(self) -> None:
+            url = urlsplit(self.path)
+            if url.path != "/search":
+                self.send_error(404)
+                return
+            q = parse_qs(url.query).get("q", [""])[0]
+            conn = db.connect(database)
+            try:
+                rows = db.find_items(conn, q)
+            except sqlite3.Error:
+                self.send_error(500)
+                return
+            finally:
+                conn.close()
+            body = json.dumps([{"name": n, "qty": qty} for n, qty in rows]).encode()
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+
+    return Handler
+
+
+def serve(database: str, host: str, port: int) -> None:
+    """Serve the search API until interrupted."""
+    with ThreadingHTTPServer((host, port), make_handler(database)) as server:
+        server.serve_forever()
