+
+def find_items(conn: sqlite3.Connection, name: str) -> list[tuple[str, int]]:
+    """Return items whose name contains `name`, sorted by name."""
+    query = f"SELECT name, qty FROM items WHERE name LIKE '%{name}%' ORDER BY name"
+    return conn.execute(query).fetchall()
