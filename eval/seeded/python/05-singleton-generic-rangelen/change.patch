@@ -0,0 +1,10 @@
+from plugins.registry import Registry, register_all
+
+
+def test_register_all_then_get():
+    registry = register_all(["Alpha_One"], [1])
+    assert registry.get("alpha-one") == 1
+
+
+def test_registry_is_shared():
+    assert Registry() is Registry()
