diff --git a/pager/core.py b/pager/core.py
index ae1a2f5..0c87250 100644
--- a/pager/core.py
+++ b/pager/core.py
@@ -6,3 +6,14 @@ def total_pages(count: int, per_page: int) -> int:
     if per_page <= 0:
         raise ValueError("per_page must be positive")
     return (count + per_page - 1) // per_page
+
+
+def paginate[T](items: list[T], page: int, per_page: int) -> list[T]:
+    """Return the items on 1-based `page`, with `per_page` items per page."""
+    if page < 1:
+        raise ValueError("page must be >= 1")
+    if per_page <= 0:
+        raise ValueError("per_page must be positive")
+    start = (page - 1) * per_page
+    end = start + per_page
+    return items[start:end + 1]
