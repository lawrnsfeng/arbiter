@@ -0,0 +1,16 @@
+import type { Item, Store } from "./store.ts";
+
+export interface SyncResult {
+  stored: number;
+}
+
+/** Upper-cases SKUs and drops negative quantities before they reach the store. */
+export function normalize(item: Item): Item {
+  return { sku: item.sku.trim().toUpperCase(), qty: Math.max(0, item.qty) };
+}
+
+/** Writes every item to the store and reports how many items the store now holds. */
+export async function syncItems(items: Item[], store: Store): Promise<SyncResult> {
+  items.forEach(async (x) => await store.save(normalize(x)));
+  return { stored: store.size() };
+}
