@@ -0,0 +1,11 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { handleSignup } from "../src/signup.ts";
+
+test("handleSignup greets a new member", () => {
+  const body = JSON.stringify({ id: 7, name: "Lin", email: "lin@example.com", role: "member" });
+  const res = handleSignup(body);
+  assert.equal(res.status, 201);
+  assert.equal(res.message, "Welcome, Lin <lin@example.com>");
+  assert.equal(res.canManageUsers, false);
+});
