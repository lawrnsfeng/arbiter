@@ -0,0 +1,14 @@
+import { displayName, type User } from "./user.ts";
+
+export interface SignupResponse {
+  status: number;
+  message: string;
+  canManageUsers: boolean;
+}
+
+/** Handles the raw JSON body of POST /signup sent by the browser. */
+export function handleSignup(body: string): SignupResponse {
+  const user = JSON.parse(body) as User;
+  const greeting = `Welcome, ${displayName(user).trim()}`;
+  return { status: 201, message: greeting, canManageUsers: user.role === "admin" };
+}
