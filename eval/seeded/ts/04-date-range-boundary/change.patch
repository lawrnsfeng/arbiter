+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { bookingsBetween } from "../src/report.ts";
+
+test("bookingsBetween keeps bookings inside the period", () => {
+  const bookings = [
+    { id: "1", day: "2026-02-28", guests: 1 },
+    { id: "2", day: "2026-03-10", guests: 2 },
+    { id: "3", day: "2026-04-02", guests: 4 },
+  ];
+  assert.deepEqual(
+    bookingsBetween(bookings, "2026-03-01", "2026-03-31").map((b) => b.id),
+    ["2"],
+  );
+});
