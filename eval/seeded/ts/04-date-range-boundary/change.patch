+import { totalGuests, type Booking } from "./booking.ts";
+
+/**
+ * Bookings whose day falls between `from` and `to`, both days included.
+ * Days are ISO YYYY-MM-DD strings, so string comparison orders them by date.
+ */
+export function bookingsBetween(bookings: Booking[], from: string, to: string): Booking[] {
+  return bookings.filter((b) => b.day >= from && b.day < to);
+}
+
+/** Guests for a reporting period, e.g. the 1st to the last day of a month. */
+export function guestsInPeriod(bookings: Booking[], from: string, to: string): number {
+  return totalGuests(bookingsBetween(bookings, from, to));
+}
