+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { renderHeading } from "../src/heading.ts";
+
+test("renderHeading shows the query in bold", () => {
+  const el = { innerHTML: "" } as unknown as HTMLElement;
+  renderHeading(el, "?q=shoes");
+  assert.equal(el.innerHTML, "Results for <strong>shoes</strong>");
+});
