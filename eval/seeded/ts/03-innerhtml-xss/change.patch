+/** Shows the search term from the page URL above the results, e.g. ?q=shoes. */
+export function renderHeading(el: HTMLElement, search: string): void {
+  const params = new URLSearchParams(search);
+  const q = params.get("q") ?? "";
+  el.innerHTML = `Results for <strong>${q}</strong>`;
+}
