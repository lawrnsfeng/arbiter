+export enum OrderStatus {
+  Pending = "pending",
+  Shipped = "shipped",
+  Delivered = "delivered",
+  Cancelled = "cancelled",
+}
+
+export default function statusLabel(status: OrderStatus, order: any): string {
+  switch (status) {
+    case OrderStatus.Pending:
+      return `Order ${order.id} is being prepared`;
+    case OrderStatus.Shipped:
+      return `Order ${order.id} is on its way`;
+    case OrderStatus.Delivered:
+      return `Order ${order.id} was delivered`;
+  }
+  return "";
+}
