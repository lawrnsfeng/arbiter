+/// Encodes a frame whose payload is `head` followed by `body`, without first
+/// joining the two slices.
+pub fn encode_pair(kind: u8, head: &[u8], body: &[u8]) -> Vec<u8> {
+    let len = (head.len() + body.len()) as u16;
+    let mut out = Vec::with_capacity(HEADER_LEN + head.len() + body.len());
+    out.push(MAGIC);
+    out.push(kind);
+    out.extend_from_slice(&len.to_be_bytes());
+    out.extend_from_slice(head);
+    out.extend_from_slice(body);
+    out
+}
