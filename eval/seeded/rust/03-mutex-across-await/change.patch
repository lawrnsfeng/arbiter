+    /// Returns the cached value for `key`, fetching and storing it on a miss.
+    pub async fn get_or_fetch<F, Fut>(&self, key: &str, fetch: F) -> String
+    where
+        F: FnOnce() -> Fut,
+        Fut: Future<Output = String>,
+    {
+        let mut map = self.inner.lock().unwrap();
+        if let Some(v) = map.get(key) {
+            return v.clone();
+        }
+        let value = fetch().await;
+        map.insert(key.to_string(), value.clone());
+        value
+    }
+
     /// Re-fetches `key` and stores the fresh value.
     pub async fn refresh<F, Fut>(&self, key: &str, fetch: F) -> String
     where
