+/// Finds the item called `name`.
+pub fn find_by_name(items: &Vec<Item>, name: &String) -> Option<Item> {
+    for i in 0..items.len() {
+        if items[i].name == name.clone() {
+            return Some(items[i].clone());
+        }
+    }
+    None
+}
+
+/// Parses `name,qty` lines into items.
+pub fn parse_items(text: &String) -> Result<Vec<Item>, Box<dyn std::error::Error>> {
+    let mut items = Vec::new();
+    for line in text.lines() {
+        let (name, qty) = line.split_once(',').ok_or("missing comma")?;
+        items.push(Item::new(name.trim(), qty.trim().parse()?));
+    }
+    Ok(items)
+}
