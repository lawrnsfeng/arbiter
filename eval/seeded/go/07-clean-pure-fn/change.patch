+func TestClamp(t *testing.T) {
+	cases := []struct{ x, lo, hi, want int }{
+		{5, 0, 10, 5},
+		{-1, 0, 10, 0},
+		{11, 0, 10, 10},
+		{0, 0, 0, 0},
+	}
+	for _, c := range cases {
+		if got := Clamp(c.x, c.lo, c.hi); got != c.want {
+			t.Errorf("Clamp(%d, %d, %d) = %d, want %d", c.x, c.lo, c.hi, got, c.want)
+		}
+	}
+	if got := Clamp("m", "a", "k"); got != "k" {
+		t.Errorf("Clamp on strings = %q, want %q", got, "k")
+	}
+}
+
+func TestClampPanicsOnInvertedRange(t *testing.T) {
+	defer func() {
+		if recover() == nil {
+			t.Fatal("want panic for lo > hi")
+		}
+	}()
+	Clamp(1, 2, 0)
+}
