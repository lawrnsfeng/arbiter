+
+// Clamp returns x limited to the closed range [lo, hi].
+// It panics if lo > hi.
+func Clamp[T cmp.Ordered](x, lo, hi T) T {
+	if lo > hi {
+		panic("mathx: Clamp called with lo > hi")
+	}
+	return min(max(x, lo), hi)
+}
