--- a/server.go
+++ b/server.go
@@ -4,15 +4,33 @@ package netdiag
 import (
 	"fmt"
 	"net/http"
+	"os/exec"
 )
 
 // NewMux returns the diagnostics HTTP handler.
 func NewMux() *http.ServeMux {
 	mux := http.NewServeMux()
 	mux.HandleFunc("GET /healthz", handleHealth)
+	mux.HandleFunc("GET /ping", handlePing)
 	return mux
 }
 
 func handleHealth(w http.ResponseWriter, _ *http.Request) {
 	fmt.Fprintln(w, "ok")
 }
+
+// handlePing pings the host given in the "host" query parameter once and
+// returns the command output.
+func handlePing(w http.ResponseWriter, r *http.Request) {
+	host := r.URL.Query().Get("host")
+	if host == "" {
+		http.Error(w, "missing host", http.StatusBadRequest)
+		return
+	}
+	out, err := exec.Command("sh", "-c", "ping -c 1 "+host).CombinedOutput()
+	if err != nil {
+		http.Error(w, string(out), http.StatusBadGateway)
+		return
+	}
+	w.Write(out)
+}
